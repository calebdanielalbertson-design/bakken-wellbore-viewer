# Large prepared data (not versioned in Git)
data/
# ...except small page content that ships with the public site
!site/dist/eor/data/
!site/dist/tours/data/
full-dataset/
!site/dist/full-dataset/
# Viewer data is fetched, except the small town-label files, which are edited by hand/script
!site/dist/viewer/data/
site/dist/viewer/data/*
!site/dist/viewer/data/reference/
site/dist/viewer/data/reference/*
!site/dist/viewer/data/reference/places.geojson
!site/dist/viewer/data/reference/metadata.json
!explorer/viewer/data/
explorer/viewer/data/*
!explorer/viewer/data/reference/
explorer/viewer/data/reference/*
!explorer/viewer/data/reference/places.geojson
!explorer/viewer/data/reference/metadata.json
explorer/gamma-data/*
!explorer/gamma-data/*.py
local-data/
*.tar.gz
*.zip
*.mp4

# Secrets and local settings
.env
.env.*
local-settings.json
.openai/
!site/.openai/

# Scratch area for refresh runs and deploy bundles
work/

# Deployment run records
backend/railway-*.json

# Python / Node
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.sites-runtime/
